{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/scene.schema.json",
  "title": "Ray Tracer Scene",
  "type": "object",

  "properties": {
    "description": {
      "type": "string"
    },

    "environment": {
      "$ref": "#/$defs/environment"
    },

    "point_lights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pointLight"
      }
    },

    "directional_lights": {
      "type": "arrayy",
      "items": {
        "$ref": "#/$defs/directionalLight"
      }
    },

    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },

    "root": {
      "$ref": "#/$defs/node"
    }
  },

  "required": [
    "environment",
    "materials",
    "root"
  ],

  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },

    "scalar": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "maxItems": 1
    },

    "environment": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/$defs/vec3"
        },
        "ambient_light": {
          "$ref": "#/$defs/vec3"
        },
        "camera_position": {
          "$ref": "#/$defs/vec3"
        },
        "camera_target": {
          "$ref": "#/$defs/vec3"
        },
        "shadows": {
          "type": "boolean"
        },
        "reflections": {
          "type": "boolean"
        },
        "refractions": {
          "type": "boolean"
        },
        "secondary_ray_eps": {
          "type": "number" 
        }
      },
      "required": [
        "background",
        "ambient_light",
        "camera_position",
        "camera_target",
        "shadows",
        "reflections",
        "refractions",
        "secondary_ray_eps"
      ]
    },

    "pointLight": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "intensity": {
          "description": "The RGB intensities of the light source. A rough rule of the the thumb is ~10x the distance between the subject and the light position, eg: if object at (10, 10, 10) and light position at (10, 10, 30) values around 300 should iluminate the subject well",
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "position",
        "intensity"
      ]
    },

    "directionalLight": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "intensity": {
          "description": "The RGB intensities of the light, not attenuated by distance, so typical values range from [0, 3]",
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "direction",
        "intensity"
      ]
    },

    "material": {
      "type": "object",
      "properties": {
        "albedo": {
          "description": "Material colour", 
          "$ref": "#/$defs/vec3"
        },
        "texture": {
          "description": "Material texture id", 
          "type": "string"
        },
        "shine": {
          "description": "This is the exponent part that controls the highlight",
          "type": "number"
        },
        "specular": {
          "description": "Shiny multiplier",
          "type": "number"
        },
        "reflectivity": {
          "description": "Between 0 and 1. Reflectivity + transparency should not exceed 1.0",
          "type": "number"
        },
        "transparency": {
          "description": "Between 0 and 1. Reflectivity + transparency should not exceed 1.0",
          "type": "number"
        },
        "ior": {
          "description": "index of refraction",
          "type": "number"
        }
      },
      "required": [
        "shine",
        "specular",
        "reflectivity",
        "transparency",
        "ior"
      ],
      "oneOf": [
        {
          "required": ["albedo"]
        },
        {
          "required": ["texture"]
        }
      ]
    },

    "scaleTransform": {
      "type": "object",
      "properties": {
        "type": {
          "const": "scale"
        },
        "value": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },

    "translateTransform": {
      "type": "object",
      "properties": {
        "type": {
          "const": "translate"
        },
        "value": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },

    "rotateXTransform": {
      "type": "object",
      "properties": {
        "type": {
          "const": "rotate_x"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },

    "rotateYTransform": {
      "type": "object",
      "properties": {
        "type": {
          "const": "rotate_y"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },

    "rotateZTransform": {
      "type": "object",
      "properties": {
        "type": {
          "const": "rotate_z"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },

    "transform": {
      "oneOf": [
        {
          "$ref": "#/$defs/scaleTransform"
        },
        {
          "$ref": "#/$defs/translateTransform"
        },
        {
          "$ref": "#/$defs/rotateXTransform"
        },
        {
          "$ref": "#/$defs/rotateYTransform"
        },
        {
          "$ref": "#/$defs/rotateZTransform"
        }
      ]
    },

    "node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "describe the node/branch"
        },

        "node_type": {
          "type": "string",
          "description": "Type of node, either a normal 'mesh' or composite 'csg-difference'",
          "enum": ["mesh", "csg_difference"]
        },

        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transform"
          }
        },

        "mesh_id": {
          "type": "string"
        },

        "material_id": {
          "type": "number"
        },

        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
